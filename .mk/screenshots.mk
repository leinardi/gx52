ifndef MK_LOCAL_SCREENSHOTS_INCLUDED
MK_LOCAL_SCREENSHOTS_INCLUDED := 1

# Local snippet (NOT part of make-common): the metainfo screenshots, regenerated by the Devel
# Flatpak's screenshot mode under a private headless weston (scripts/screenshots.sh). Needs weston
# on the host, next to the Flatpak prerequisites.

SCREENSHOTS_DIR ?= data/screenshots

.PHONY: screenshots
screenshots: flatpak-install ## Regenerate the metainfo screenshots into data/screenshots (needs weston)
	scripts/screenshots.sh $(SCREENSHOTS_DIR)

endif  # MK_LOCAL_SCREENSHOTS_INCLUDED
