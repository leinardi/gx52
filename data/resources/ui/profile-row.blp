using Gtk 4.0;

template $GX52ProfileRow: ListBoxRow {
  child: Box {
    spacing: 6;

    Image drag_handle {
      icon-name: "list-drag-handle-symbolic";

      styles [
        "drag-handle",
      ]
    }

    Image warning_icon {
      icon-name: "dialog-warning-symbolic";
      visible: false;
    }

    Stack name_stack {
      hexpand: true;
      vhomogeneous: false;

      StackPage {
        name: "label";

        child: Label title_label {
          xalign: 0;
          ellipsize: end;
        };
      }

      StackPage {
        name: "entry";

        child: Box {
          orientation: vertical;
          spacing: 3;

          Entry name_entry {
            accessibility {
              label: _("Profile name");
            }
          }

          Label name_problem {
            xalign: 0;
            wrap: true;
            visible: false;

            styles [
              "caption",
              "error",
            ]
          }
        };
      }
    }

    Box badges {
      spacing: 2;
      valign: center;
      visible: false;

      Label badge_one {
        label: "1";

        styles [
          "mode-badge",
        ]
      }

      Label badge_two {
        label: "2";

        styles [
          "mode-badge",
        ]
      }

      Label badge_three {
        label: "3";

        styles [
          "mode-badge",
        ]
      }
    }

    Image active_icon {
      icon-name: "object-select-symbolic";
      visible: false;
      tooltip-text: _("Active profile");
    }

    MenuButton menu_button {
      icon-name: "view-more-symbolic";
      valign: center;
      tooltip-text: _("Profile Menu");

      styles [
        "flat",
      ]
    }
  };
}
