using Gtk 4.0;
using Adw 1;

template $GX52InputTester: Adw.Bin {
  child: Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "none";

      child: Adw.StatusPage {
        icon-name: "input-gaming-symbolic";
        title: _("Connect your X52 or X52 Pro");
        description: _("The live view of every input appears here once the joystick is plugged in.");
      };
    }

    StackPage {
      name: "live";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Adw.Clamp {
          maximum-size: 1000;

          child: Box {
            orientation: vertical;
            spacing: 18;
            margin-top: 18;
            margin-bottom: 36;
            margin-start: 12;
            margin-end: 12;

            Label {
              label: _("Live view of the device. Input is read without grabbing it, so games keep receiving it.");
              wrap: true;
              xalign: 0;

              styles [
                "dimmed",
              ]
            }

            Label unverified {
              label: _("The X52 input map has not been verified on a device yet. Names may not match the controls.");
              wrap: true;
              xalign: 0;
              visible: false;

              styles [
                "caption",
                "warning",
              ]
            }

            Adw.WrapBox cards {
              child-spacing: 12;
              line-spacing: 12;
              justify: fill;
              justify-last-line: true;
            }
          };
        };
      };
    }
  };
}
