using Gtk 4.0;
using Adw 1;

template $GX52Window: Adw.ApplicationWindow {
  title: _("GX52");
  default-width: 800;
  default-height: 600;
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 600sp")

    setters {
      split_view.collapsed: true;
      switcher_bar.reveal: true;
      title_stack.visible-child-name: "title";
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Stack main_stack {
      transition-type: crossfade;

      StackPage {
        name: "waiting";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [start]
            MenuButton {
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");
              menu-model: primary_menu;
            }
          }

          content: Adw.StatusPage waiting_page {
            icon-name: "com.leinardi.gx52-symbolic";
            title: _("Connect your X52 or X52 Pro");
            description: _("Your profiles appear here once a joystick is connected.");
          };
        };
      }

      StackPage {
        name: "profiles";

        child: Adw.NavigationSplitView split_view {
          sidebar: Adw.NavigationPage {
            title: _("GX52");

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [start]
                MenuButton {
                  primary: true;
                  icon-name: "open-menu-symbolic";
                  tooltip-text: _("Main Menu");
                  menu-model: primary_menu;
                }

                [end]
                MenuButton {
                  icon-name: "list-add-symbolic";
                  tooltip-text: _("New Profile");
                  menu-model: new_menu;
                }
              }

              content: ScrolledWindow {
                hscrollbar-policy: never;

                child: Box {
                  orientation: vertical;

                  ListBox profile_list {
                    accessibility {
                      label: _("Profiles");
                    }

                    styles [
                      "navigation-sidebar",
                    ]
                  }

                  ListBox test_list {
                    accessibility {
                      label: _("Test input");
                    }

                    ListBoxRow test_row {
                      child: Box {
                        spacing: 12;

                        Image {
                          icon-name: "input-gaming-symbolic";
                          accessible-role: presentation;
                        }

                        Label {
                          label: _("Test input");
                          xalign: 0;
                          hexpand: true;
                          ellipsize: end;
                        }

                        Image {
                          icon-name: "go-next-symbolic";
                          accessible-role: presentation;
                        }
                      };
                    }

                    styles [
                      "navigation-sidebar",
                    ]
                  }
                };
              };

              [bottom]
              $GX52DeviceFooter footer {}
            };
          };

          content: Adw.NavigationPage content_page {
            title: _("Profile");

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                title-widget: Stack title_stack {
                  hhomogeneous: false;
                  // Wide: the switcher over the editor, the title over the other pages.
                  StackPage {
                    name: "switcher";

                    child: Stack wide_title_stack {
                      hhomogeneous: false;

                      StackPage {
                        name: "switcher";

                        child: Adw.ViewSwitcher {
                          stack: view_stack;
                          policy: wide;
                        };
                      }

                      StackPage {
                        name: "title";

                        child: Adw.WindowTitle {
                          title: bind content_page.title;
                        };
                      }
                    };
                  }

                  StackPage {
                    name: "title";

                    child: Adw.WindowTitle {
                      title: bind content_page.title;
                    };
                  }
                };
              }

              [top]
              Adw.Banner x52d_banner {
                title: _("x52d is running and may overwrite these settings");
                button-label: _("_Learn More");
                action-name: "win.x52d-help";
              }

              content: Stack content_stack {
                StackPage {
                  name: "editor";

                  child: Adw.ViewStack view_stack {
                    Adw.ViewStackPage {
                      name: "leds";
                      title: _("LEDs");
                      icon-name: "display-brightness-symbolic";

                      child: $GX52LedEditor led_editor {};
                    }

                    Adw.ViewStackPage {
                      name: "mfd";
                      title: _("MFD");
                      icon-name: "video-display-symbolic";

                      child: $GX52MfdEditor mfd_editor {};
                    }

                    Adw.ViewStackPage {
                      name: "clocks";
                      title: _("Clocks");
                      icon-name: "preferences-system-time-symbolic";

                      child: $GX52ClockEditor clock_editor {};
                    }
                  };
                }

                StackPage {
                  name: "failed";

                  child: Adw.StatusPage failed_page {
                    icon-name: "dialog-warning-symbolic";

                    child: Box failed_actions {
                      halign: center;
                      spacing: 12;

                      Button {
                        label: _("_Show File");
                        use-underline: true;
                        action-name: "win.show-selected-file";

                        styles [
                          "pill",
                        ]
                      }

                      Button {
                        label: _("_Remove");
                        use-underline: true;
                        action-name: "win.remove-selected";

                        styles [
                          "pill",
                          "destructive-action",
                        ]
                      }
                    };
                  };
                }

                StackPage {
                  name: "no-permission";

                  child: $GX52UdevGuide udev_guide {};
                }

                StackPage {
                  name: "tester";

                  child: $GX52InputTester input_tester {};
                }
              };

              [bottom]
              Adw.ViewSwitcherBar switcher_bar {
                stack: view_stack;
              }
            };
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Import Profile…");
      action: "win.import";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About GX52");
      action: "app.about";
    }
  }
}

menu new_menu {
  section {
    item {
      label: _("New _Single Profile");
      action: "win.new-profile";
    }

    item {
      label: _("New _Per-Mode Profile");
      action: "win.new-per-mode-profile";
    }
  }
}
