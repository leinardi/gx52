using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: C_("shortcut window", "Profiles");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "New Single Profile");
      action-name: "win.new-profile";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Import Profile");
      action-name: "win.import";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Export the Selected Profile");
      action-name: "win.export-selected";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Rename the Selected Profile");
      accelerator: "F2";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Remove the Selected Profile");
      accelerator: "Delete";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcut window", "General");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show the LEDs");
      action-name: "win.show-view::leds";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show the MFD");
      action-name: "win.show-view::mfd";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show the Clocks");
      action-name: "win.show-view::clocks";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Close Window");
      action-name: "window.close";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      action-name: "app.quit";
    }
  }
}
