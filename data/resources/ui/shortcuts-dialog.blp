using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show the LEDs");
      action-name: "win.show-view::leds";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show the MFD");
      action-name: "win.show-view::mfd";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show the Clocks");
      action-name: "win.show-view::clocks";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Close Window");
      action-name: "window.close";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      action-name: "app.quit";
    }
  }
}
