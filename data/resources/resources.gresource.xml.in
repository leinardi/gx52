<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <!-- The prefix is the base app path (no .Devel). It must match `resource-base-path`
       so libadwaita auto-loads style.css, icons/ and shortcuts-dialog.ui. -->
  <gresource prefix="/com/leinardi/gx52">
    <file compressed="true" preprocess="xml-stripblanks" alias="ui/window.ui">window.ui</file>
    <file compressed="true" preprocess="xml-stripblanks" alias="ui/profile-row.ui">profile-row.ui</file>
    <file compressed="true" preprocess="xml-stripblanks" alias="ui/device-footer.ui">device-footer.ui</file>
    <file compressed="true" preprocess="xml-stripblanks" alias="ui/led-button.ui">led-button.ui</file>
    <file compressed="true" preprocess="xml-stripblanks" alias="ui/led-editor.ui">led-editor.ui</file>
    <file compressed="true" preprocess="xml-stripblanks" alias="ui/mfd-display.ui">mfd-display.ui</file>
    <file compressed="true" preprocess="xml-stripblanks" alias="ui/mfd-editor.ui">mfd-editor.ui</file>
    <file compressed="true" preprocess="xml-stripblanks" alias="ui/mode-bar.ui">mode-bar.ui</file>
    <file compressed="true" preprocess="xml-stripblanks" alias="ui/clock-editor.ui">clock-editor.ui</file>
    <file compressed="true" preprocess="xml-stripblanks" alias="ui/zone-clock-group.ui">zone-clock-group.ui</file>
    <file compressed="true" preprocess="xml-stripblanks" alias="ui/zone-dialog.ui">zone-dialog.ui</file>
    <file compressed="true" preprocess="xml-stripblanks" alias="ui/preferences-dialog.ui">preferences-dialog.ui</file>
    <!-- Root alias: AdwApplication wires app.shortcuts / Ctrl+? to it automatically. -->
    <file compressed="true" preprocess="xml-stripblanks" alias="shortcuts-dialog.ui">shortcuts-dialog.ui</file>
    <file compressed="true">style.css</file>
    <!-- Icons under <resource-base-path>/icons join the icon theme, so the symbolic icon resolves
         by its base name in every profile and uninstalled under `meson devenv`. -->
    <file compressed="true" preprocess="xml-stripblanks" alias="icons/scalable/actions/com.leinardi.gx52-symbolic.svg">../icons/com.leinardi.gx52-symbolic.svg</file>
    <file compressed="true" preprocess="xml-stripblanks" alias="icons/scalable/actions/mfd-clock-symbolic.svg">icons/mfd-clock-symbolic.svg</file>
    <file compressed="true" preprocess="xml-stripblanks" alias="metainfo.xml">@metainfo-file@</file>
  </gresource>
</gresources>
