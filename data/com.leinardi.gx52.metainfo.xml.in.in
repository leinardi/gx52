<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2019 Roberto Leinardi -->
<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>GX52</name>
  <summary>Configure your X52 joystick</summary>
  <description>
    <p>GX52 configures the LEDs, the brightness and the multi-function display of the Logitech
      (Saitek) X52 and X52 Pro joysticks.</p>
  </description>
  <developer id="com.leinardi">
    <name translate="no">Roberto Leinardi</name>
  </developer>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
  <translation type="gettext">@gettext-package@</translation>
  <url type="homepage">https://leinardi.github.io/gx52/</url>
  <url type="bugtracker">https://github.com/leinardi/gx52/issues</url>
  <url type="vcs-browser">https://github.com/leinardi/gx52</url>
  <update_contact>roberto@leinardi.com</update_contact>
  <content_rating type="oars-1.1" />
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <!-- Regenerated with make screenshots, in the order of src/screenshots/capture.rs (docs/internal/release.md,
       "Screenshots"). The URLs follow the trunk, not the tag: the release gate mirrors them before
       the tag exists. -->
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/leinardi/gx52/main/data/screenshots/leds.png</image>
      <caption>Set the LEDs of a profile</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/leinardi/gx52/main/data/screenshots/mfd.png</image>
      <caption>Write the text of the multi-function display</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/leinardi/gx52/main/data/screenshots/clocks.png</image>
      <caption>Show three clocks in real time zones</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/leinardi/gx52/main/data/screenshots/names.png</image>
      <caption>Give the controls custom names</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/leinardi/gx52/main/data/screenshots/profiles.png</image>
      <caption>Keep a profile per mode, and import and export profiles</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/leinardi/gx52/main/data/screenshots/preferences.png</image>
      <caption>Run in the background and use the ministick as a mouse</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/leinardi/gx52/main/data/screenshots/tester.png</image>
      <caption>Test every button, axis and hat live</caption>
    </screenshot>
  </screenshots>
  <!-- Newest first. The release workflow adds the entry for each new version (docs/internal/release.md);
       the 0.7.x entries are the legacy Python application's history. -->
  <releases>
    <release version="1.1.1" date="2026-11-24">
      <description translate="no">
        <ul>
          <li>Bump the cargo-crates group with 5 updates</li>
          <li>Point the homepage at the documentation site</li>
          <li>Adapt to the jiff 1.0 API</li>
        </ul>
      </description>
    </release>
    <release version="1.1.0" date="2026-11-20">
      <description translate="no">
        <ul>
          <li>Add control names in schema version 2</li>
          <li>Show custom names on the Last button line and hold wheel notches</li>
          <li>Add the Names view</li>
          <li>Show custom control names</li>
          <li>Number the controls in the Names view</li>
          <li>Scroll to a revealed name once its group is laid out</li>
          <li>Profiles saved by this version are listed in GX52 1.0.x but cannot be loaded or edited there</li>
        </ul>
      </description>
    </release>
    <release version="1.0.1" date="2026-11-19">
      <description translate="no">
        <ul>
          <li>Shorten the summary to Flathub's 35 characters</li>
          <li>Leave a margin around the app icon</li>
          <li>Use grey brand colours and show the window's corners and shadow</li>
          <li>Use blue brand colours</li>
          <li>Add the input tester screenshot</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-11-18">
      <description translate="no">
        <ul>
          <li>GX52 is rewritten in Rust with GTK 4 and libadwaita</li>
          <li>Per-mode profiles for the LEDs, the MFD and the brightness; GX52 0.7 profiles are imported</li>
          <li>Time zones for the MFD clocks, custom MFD text, and profile import and export</li>
          <li>A tray icon, running in the background and starting on login</li>
          <li>An input tester, a virtual mouse on the throttle ministick, and udev guidance in the app</li>
          <li>The profiles of a GX52 0.7 installed from source, not from Flathub, are copied into the Flatpak first: the README shows how</li>
          <li>The X52 (non-Pro) is supported on a best-effort basis: it has not been tested on a device</li>
        </ul>
      </description>
    </release>
    <release version="0.99.0" date="2026-11-17">
      <description translate="no">
        <ul>
          <li>GX52 is rewritten in Rust with GTK 4 and libadwaita</li>
          <li>Per-mode profiles for the LEDs, the MFD and the brightness; GX52 0.7 profiles are imported</li>
          <li>Time zones for the MFD clocks, custom MFD text, and profile import and export</li>
          <li>A tray icon, running in the background and starting on login</li>
          <li>An input tester, a virtual mouse on the throttle ministick, and udev guidance in the app</li>
        </ul>
      </description>
    </release>
    <release version="0.7.6" date="2023-05-07">
      <description translate="no">
        <ul>
          <li>Updated dependencies</li>
        </ul>
      </description>
    </release>
    <release version="0.7.5" date="2022-04-01">
      <description translate="no">
        <ul>
          <li>Updated dependencies</li>
        </ul>
      </description>
    </release>
    <release version="0.7.4" date="2021-08-28">
      <description translate="no">
        <ul>
          <li>Updated dependencies</li>
        </ul>
      </description>
    </release>
    <release version="0.7.3" date="2021-03-07">
      <description translate="no">
        <ul>
          <li>Fixed #2: Date formats DD-MM-YY and MM-DD-YY are swapped</li>
          <li>Updated dependencies</li>
        </ul>
      </description>
    </release>
    <release version="0.7.2" date="2020-06-28">
      <description translate="no">
        <ul>
          <li>Check for new App version on launch (requires opt-in)</li>
          <li>Updated dependencies</li>
        </ul>
      </description>
    </release>
    <release version="0.7.1" date="2020-04-04">
      <description translate="no">
        <ul>
          <li>Fixed crash for non Pro models (peewee.OperationalError: no such column:
            t2.can_be_removed)</li>
        </ul>
      </description>
    </release>
    <release version="0.7.0" date="2020-03-29">
      <description translate="no">
        <ul>
          <li>Initial release</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
