<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="@gettext-package@">
  <schema id="@app-id@" path="@app-path@">
    <key name="window-width" type="i">
      <default>800</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>600</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="active-profile-x52-pro" type="s">
      <default>'x52-pro-default'</default>
      <summary>Active X52 Pro profile</summary>
      <description>The id of the profile an X52 Pro shows. An id that names no X52 Pro profile uses the default profile.</description>
    </key>
    <key name="active-profile-x52" type="s">
      <default>'x52-default'</default>
      <summary>Active X52 profile</summary>
      <description>The id of the profile an X52 shows. An id that names no X52 profile uses the default profile.</description>
    </key>
    <key name="profile-order-x52-pro" type="as">
      <default>[]</default>
      <summary>Order of the X52 Pro profiles</summary>
      <description>The ids of the X52 Pro profiles other than the default, in the order the profile list shows them. The default profile is always first; profiles not listed follow in name order.</description>
    </key>
    <key name="profile-order-x52" type="as">
      <default>[]</default>
      <summary>Order of the X52 profiles</summary>
      <description>The ids of the X52 profiles other than the default, in the order the profile list shows them. The default profile is always first; profiles not listed follow in name order.</description>
    </key>
    <key name="last-device-type" type="s">
      <default>''</default>
      <summary>Type of the last device</summary>
      <description>The device type of the last joystick GX52 saw, x52-pro or x52; its profiles are shown while no joystick is connected. Empty before the first one.</description>
    </key>
    <key name="autostart" type="b">
      <default>false</default>
      <summary>Start when logging in</summary>
      <description>Start GX52 in the background when logging in.</description>
    </key>
    <key name="run-in-background" type="b">
      <default>true</default>
      <summary>Run in the background</summary>
      <description>Keep GX52 running when its window is closed, so the joystick keeps its profile and clocks.</description>
    </key>
    <key name="virtual-mouse" type="b">
      <default>false</default>
      <summary>Use the ministick as a mouse</summary>
      <description>Move the pointer with the ministick, click with the primary and the scroll wheel buttons and scroll with the scroll wheel. Needs write access to /dev/uinput.</description>
    </key>
    <key name="virtual-mouse-speed" type="d">
      <range min="0.1" max="3.0"/>
      <default>0.6</default>
      <summary>Virtual mouse speed</summary>
      <description>The pointer speed, in pixels per ministick step every 10 ms.</description>
    </key>
    <key name="virtual-mouse-curve" type="d">
      <range min="1.0" max="3.0"/>
      <default>1.6</default>
      <summary>Virtual mouse curve</summary>
      <description>The exponent applied to the ministick offset: 1 is linear, higher values move slowly near the centre and fast at the edge.</description>
    </key>
    <key name="virtual-mouse-deadzone" type="u">
      <range min="0" max="4"/>
      <default>1</default>
      <summary>Virtual mouse deadzone</summary>
      <description>The ministick steps around the centre treated as centred.</description>
    </key>
    <key name="virtual-mouse-invert-wheel" type="b">
      <default>false</default>
      <summary>Invert the virtual mouse wheel</summary>
      <description>Scroll the other way with the scroll wheel.</description>
    </key>
    <key name="legacy-import-done" type="b">
      <default>false</default>
      <summary>GX52 0.7 profiles imported</summary>
      <description>Whether the one-time import of the GX52 0.7 profile database is over.</description>
    </key>
  </schema>
</schemalist>
