<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="@gettext-package@">
  <schema id="@app-id@" path="@app-path@">
    <key name="window-width" type="i">
      <default>800</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>600</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="mode-profiles-x52-pro" type="as">
      <default>['x52-pro-default', 'x52-pro-default', 'x52-pro-default']</default>
      <summary>X52 Pro profiles of the modes</summary>
      <description>The ids of the profiles that modes 1, 2 and 3 of the mode selector use on an X52 Pro. An id that names no X52 Pro profile uses the default profile.</description>
    </key>
    <key name="mode-profiles-x52" type="as">
      <default>['x52-default', 'x52-default', 'x52-default']</default>
      <summary>X52 profiles of the modes</summary>
      <description>The ids of the profiles that modes 1, 2 and 3 of the mode selector use on an X52. An id that names no X52 profile uses the default profile.</description>
    </key>
  </schema>
</schemalist>
